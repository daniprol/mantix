{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/*": {
      "entry": ["src/bin.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "examples": {
      "entry": ["*.ts"]
    },
    "apps/demo-target": {
      "entry": ["src/server.ts"]
    }
  },
  "ignoreDependencies": ["@changesets/cli", "@effect/language-service"]
}
