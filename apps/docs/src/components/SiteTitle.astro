---
/**
 * Override of Starlight's SiteTitle: the Mantix logo (one file per theme,
 * from public/logo) and a small pre-release tag, because Mantix has not
 * reached 1.0 yet.
 */
import { withBase } from '../lib/base.ts'

const { siteTitleHref } = Astro.locals.starlightRoute
---

<a href={siteTitleHref} class="site-title" translate="no">
  <img class="logo logo-dark" src={withBase('/logo/mantix-logo-dark.svg')} alt="Mantix" width="134" height="28" />
  <img class="logo logo-light" src={withBase('/logo/mantix-logo-light.svg')} alt="Mantix" width="134" height="28" />
  <span class="tag">pre-release</span>
</a>

<style>
  .site-title {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--mx-ink);
    white-space: nowrap;
  }
  .logo {
    display: block;
    height: 1.75rem;
    width: auto;
  }
  /* Dark is Starlight's default theme; light is data-theme='light'. */
  :global(:root[data-theme='light']) .logo-dark,
  :global(:root:not([data-theme='light'])) .logo-light {
    display: none;
  }
  .tag {
    font-family: var(--__sl-font-mono);
    font-size: 0.6875rem;
    color: var(--mx-ink-3);
    border: 1px solid var(--mx-hairline);
    border-radius: 2px;
    padding: 0.05rem 0.35rem;
  }
  @media (max-width: 30rem) {
    .tag {
      display: none;
    }
  }
</style>
