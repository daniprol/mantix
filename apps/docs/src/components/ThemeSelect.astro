---
/**
 * Override of Starlight's ThemeSelect: a three-way segmented switch
 * (auto, light, dark) instead of a <select>. It keeps Starlight's
 * behaviour exactly: the choice is stored under the same localStorage key,
 * and "auto" follows the operating system.
 */
const options = [
  { value: 'auto', label: Astro.locals.t('themeSelect.auto') },
  { value: 'light', label: Astro.locals.t('themeSelect.light') },
  { value: 'dark', label: Astro.locals.t('themeSelect.dark') },
] as const
---

<mx-theme-switch>
  <div
    class="switch"
    role="radiogroup"
    aria-label={Astro.locals.t('themeSelect.accessibleLabel')}
  >
    {
      options.map(({ value, label }) => (
        <button
          type="button"
          role="radio"
          aria-checked={value === 'auto' ? 'true' : 'false'}
          data-value={value}
          title={label}
        >
          <span class="sr-only">{label}</span>
          {value === 'auto' && (
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <circle cx="8" cy="8" r="5.5" />
              <path d="M8 2.5v11a5.5 5.5 0 0 0 0-11Z" class="fill" />
            </svg>
          )}
          {value === 'light' && (
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <circle cx="8" cy="8" r="3" />
              <path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M3.4 12.6l1.1-1.1M11.5 4.5l1.1-1.1" />
            </svg>
          )}
          {value === 'dark' && (
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M13.5 9.5A5.5 5.5 0 0 1 6.5 2.5a5.5 5.5 0 1 0 7 7Z" />
            </svg>
          )}
        </button>
      ))
    }
  </div>
</mx-theme-switch>

<style>
  .switch {
    display: inline-flex;
    border: 1px solid var(--mx-hairline);
    border-radius: 3px;
    padding: 1px;
    gap: 1px;
  }
  button {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.5rem;
    border: 0;
    border-radius: 2px;
    background: transparent;
    color: var(--mx-ink-3);
    cursor: pointer;
    transition: color 120ms ease-out;
  }
  button:hover {
    color: var(--mx-ink);
  }
  button[aria-checked='true'] {
    background: var(--mx-paper-2);
    color: var(--mx-ink);
    box-shadow: inset 0 0 0 1px var(--mx-hairline);
  }
  svg {
    width: 0.875rem;
    height: 0.875rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
  }
  svg .fill {
    fill: currentColor;
    stroke: none;
  }
</style>

<script>
  type Theme = 'auto' | 'dark' | 'light'

  // Same key as Starlight's own ThemeSelect, so its early inline script
  // (ThemeProvider) applies the saved choice before the page paints.
  const storageKey = 'starlight-theme'

  const parseTheme = (value: unknown): Theme =>
    value === 'light' || value === 'dark' ? value : 'auto'

  const loadTheme = (): Theme => {
    try {
      return parseTheme(localStorage.getItem(storageKey))
    } catch {
      return 'auto'
    }
  }

  const systemTheme = (): 'light' | 'dark' =>
    matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'

  const apply = (theme: Theme): void => {
    document.documentElement.dataset.theme =
      theme === 'auto' ? systemTheme() : theme
    try {
      localStorage.setItem(storageKey, theme === 'auto' ? '' : theme)
    } catch {
      // Storage can be blocked; the theme still applies for this page.
    }
    // There are two switches (header and mobile menu); keep both in step.
    document
      .querySelectorAll<HTMLButtonElement>('mx-theme-switch button')
      .forEach(button => {
        button.setAttribute(
          'aria-checked',
          String(button.dataset.value === theme),
        )
      })
  }

  matchMedia('(prefers-color-scheme: light)').addEventListener(
    'change',
    () => {
      if (loadTheme() === 'auto') apply('auto')
    },
  )

  class MxThemeSwitch extends HTMLElement {
    constructor() {
      super()
      apply(loadTheme())
      this.querySelectorAll<HTMLButtonElement>('button').forEach(button => {
        button.addEventListener('click', () =>
          apply(parseTheme(button.dataset.value)),
        )
      })
    }
  }
  customElements.define('mx-theme-switch', MxThemeSwitch)
</script>
