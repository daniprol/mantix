{
  "name": "mantix",
  "version": "0.0.0",
  "description": "Load tests that tell the truth, written in TypeScript",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniprol/mantix.git",
    "directory": "packages/server"
  },
  "keywords": [
    "load-testing",
    "benchmark",
    "performance",
    "k6",
    "locust",
    "effect"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "mantix": "./src/bin.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "bin": {
      "mantix": "./dist/bin.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "effect-tsgo tsc --noEmit -p ."
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "effect": "catalog:",
    "undici": "catalog:"
  },
  "devDependencies": {
    "@mantix/api": "workspace:*",
    "@mantix/core": "workspace:*",
    "@mantix/web": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:"
  }
}
